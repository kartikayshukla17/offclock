# Neon Postgres — https://neon.tech
# Use the POOLED connection string (host has a "-pooler" segment). The
# direct endpoint gets administratively closed on Neon's autosuspend and
# throws SQLSTATE 57P01 against a long-lived PrismaClient.
DATABASE_URL="postgresql://user:password@host-pooler/neondb?sslmode=require"

# Firebase client (Console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Console → Project settings → Service accounts → Generate key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Public app URL (share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Dashboard → Developers → API keys; use sk_test_/pk_test_ in dev)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dashboard → Product catalog → your Pro product → Price ID
STRIPE_PRICE_ID=
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints this — regenerates each run
STRIPE_WEBHOOK_SECRET=
